{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "./ascii.txt",
    "height": 30,
    "width": 15,
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╭─ Hardware ──────────────────────────────────────────╮",
    },
    {
      "type": "host",
      "key": "  󰌢 Host     ",
      "keyColor": "#b4f9f8",
    },
    {
      "type": "cpu",
      "key": "   CPU      ",
      "keyColor": "#b4f9f8",
    },
    {
      "type": "gpu",
      "key": "  󰍛 GPU      ",
      "keyColor": "#b4f9f8",
    },
    {
      "type": "memory",
      "key": "  󰑭 Memory   ",
      "keyColor": "#b4f9f8",
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk     ",
      "keyColor": "#b4f9f8",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╰─────────────────────────────────────────────────────╯",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╭─ System ────────────────────────────────────────────╮",
    },
    {
      "type": "os",
      "key": "  󰣇 OS       ",
      "keyColor": "#89ddff",
    },
    {
      "type": "kernel",
      "key": "   Kernel   ",
      "keyColor": "#89ddff",
    },
    {
      "type": "bios",
      "key": "  󰘚 BIOS     ",
      "keyColor": "#89ddff",
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages ",
      "keyColor": "#89ddff",
    },
    {
      "type": "shell",
      "key": "   Shell    ",
      "keyColor": "#89ddff",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╰─────────────────────────────────────────────────────╯",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╭─ Desktop ───────────────────────────────────────────╮",
    },
    {
      "type": "de",
      "key": "   DE       ",
      "keyColor": "#9abdf5",
    },
    {
      "type": "wm",
      "key": "   WM       ",
      "keyColor": "#9abdf5",
    },
    {
      "type": "wmtheme",
      "key": "  󰉼 Theme    ",
      "keyColor": "#9abdf5",
    },
    {
      "type": "terminal",
      "key": "   Terminal ",
      "keyColor": "#9abdf5",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╰─────────────────────────────────────────────────────╯",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╭─ Session ───────────────────────────────────────────╮",
    },
    {
      "type": "command",
      "key": "  󰔠 OS Age   ",
      "keyColor": "#c0caf5",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime   ",
      "keyColor": "#c0caf5",
    },
    {
      "type": "datetime",
      "key": "  󰃭 DateTime ",
      "keyColor": "#c0caf5",
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;86;95;137m╰─────────────────────────────────────────────────────╯",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
